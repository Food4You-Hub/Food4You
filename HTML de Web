        // ---------- Carrito / Ticket ----------
        function addToCart(id) {
            const product = products.find(p => p.id === id);
            const exist = cart.find(item => item.product.id === id);
            if (exist) {
                exist.qty++;
            } else {
                if (cart.length >= MAX_LINEAS) {
                    alert(`Cada pedido admite hasta ${MAX_LINEAS} productos distintos (puedes aumentar las cantidades). Realiza otro pedido para el resto.`);
                    return false;
                }
                cart.push({ product, qty: 1 });
            }
            updateTicket();
            return true;
        }

        function buyNow(id) {
            if (addToCart(id)) navigate('checkout-view');
        }

        function updateQty(id, change) {
            const item = cart.find(i => i.product.id === id);
            if (item) {
                item.qty += change;
                if (item.qty <= 0) cart = cart.filter(i => i.product.id !== id);
            }
            updateTicket();
        }

        function removeItem(id) {
            cart = cart.filter(i => i.product.id !== id);
            updateTicket();
        }

        function updateTicket() {
            const inEU = isEU();
            const tbody = document.getElementById('ticket-body');
            tbody.innerHTML = '';

            const t = calcTotals(cart, inEU);
            let totalArticulos = 0;

            if (cart.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" style="color:#777; text-align:center;">Tu cesta está vacía</td></tr>';
            }

            t.lines.forEach(l => {
                totalArticulos += l.qty;
                const ivaTxt = inEU ? `IVA ${Math.round(l.rate * 100)}%` : 'Sin IVA · fuera de la UE';
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${l.product.name} <br><small style="color:#777;">(${ivaTxt})</small></td>
                    <td>
                        <div class="qty-controls">
                            <button type="button" class="qty-btn" onclick="updateQty(${l.product.id}, -1)">-</button>
                            ${l.qty}
                            <button type="button" class="qty-btn" onclick="updateQty(${l.product.id}, 1)">+</button>
                        </div>
                    </td>
                    <td>€${l.base.toFixed(2)}</td>
                    <td><button type="button" class="delete-btn" onclick="removeItem(${l.product.id})" aria-label="Quitar">×</button></td>
                `;
                tbody.appendChild(tr);
            });

            document.getElementById('cart-count').innerText = totalArticulos;
            document.getElementById('base-total').innerText = t.base.toFixed(2);
            document.getElementById('iva-total').innerText = t.iva.toFixed(2);
            document.getElementById('grand-total').innerText = t.total.toFixed(2);
            document.getElementById('iva-note').hidden = inEU;
        }

        // ---------- Navegación ----------
        function navigate(viewId, category = null, btnElement = null) {
            if (isNavigating && currentView !== viewId) return;
            if (btnElement) {
                document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));
                btnElement.classList.add('active');
            }
            document.getElementById('navbar').classList.toggle('on-landing', viewId === 'landing-view');
            if (currentView !== viewId) {
                isNavigating = true;
                const oldView = document.getElementById(currentView);
                const newView = document.getElementById(viewId);
                oldView.style.opacity = '0';
                setTimeout(() => {
                    oldView.classList.add('hidden-section');
                    newView.classList.remove('hidden-section');
                    if (category) renderProducts(category);
                    void newView.offsetWidth;
                    newView.style.opacity = '1';
                    currentView = viewId;
                    isNavigating = false;
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }, 300);
            } else if (category) {
                renderProducts(category);
            }
        }

        // ---------- Numeración de documentos (se guarda en el navegador) ----------
        function siguienteNumero() {
            const year = new Date().getFullYear();
            const key = 'food4you_contador_' + year;
            let n = 1;
            try {
                n = (parseInt(localStorage.getItem(key), 10) || 0) + 1;
                localStorage.setItem(key, String(n));
            } catch (e) { /* sin almacenamiento: empieza siempre en 1 */ }
            return { year, seq: String(n).padStart(3, '0') };
        }

