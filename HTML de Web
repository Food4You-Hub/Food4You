        function cargarPaises() {
            const sel = document.getElementById('form-country');
            const crearGrupo = (titulo, lista) => {
                const g = document.createElement('optgroup');
                g.label = titulo;
                [...lista].sort((a, b) => a.localeCompare(b, 'es')).forEach(p => {
                    const o = document.createElement('option');
                    o.value = p; o.textContent = p;
                    if (p === 'España') o.setAttribute('selected', 'selected'); // valor por defecto (también tras reset())
                    g.appendChild(o);
                });
                return g;
            };
            sel.appendChild(crearGrupo('Unión Europea', EU_COUNTRIES));
            sel.appendChild(crearGrupo('Fuera de la UE', NON_EU_COUNTRIES));
            const otro = document.createElement('option');
            otro.value = OTHER_COUNTRY; otro.textContent = OTHER_COUNTRY;
            sel.appendChild(otro);
        }

        function isEU() { return document.getElementById('form-eu').checked; }

        // Marca/desmarca el tick según el país y refresca el ticket
        function sincronizarUE() {
            const pais = document.getElementById('form-country').value;
            const chk = document.getElementById('form-eu');
            const hint = document.getElementById('eu-hint');
            if (pais === OTHER_COUNTRY) {
                chk.disabled = false;
                chk.checked = false;
                hint.textContent = "Marca la casilla solo si el país pertenece a la UE. Fuera de la UE la factura se emite sin IVA.";
            } else {
                chk.disabled = true;
                chk.checked = EU_COUNTRIES.includes(pais);
                hint.textContent = "Se marca automáticamente según el país. Fuera de la UE la factura se emite sin IVA.";
            }
            updateTicket();
        }

