            de: "food4you.cv@gmail.com",
            asunto: "Pedido Food4You",
            cuerpo: "Buenos días,\n\nLe adjuntamos la documentación relacionada con su compra a Food4You.\n\nGracias por confiar en nosotros, un saludo."
        };

        // ---------- Pago ----------
        function procesarPago(e) {
            e.preventDefault();
            if (cart.length === 0) {
                alert("Tu cesta está vacía.");
                return;
            }

            const num = siguienteNumero();
            currentOrder = {
                client: {
                    nombre: document.getElementById('form-name').value.trim(),
                    email: document.getElementById('form-email').value.trim(),
                    nif: document.getElementById('form-nif').value.trim(),
                    tel: document.getElementById('form-tel').value.trim(),
                    direccion: document.getElementById('form-dir').value.trim(),
                    cp: document.getElementById('form-cp').value.trim(),
                    ciudad: document.getElementById('form-city').value.trim(),
                    pais: document.getElementById('form-country').value
                },
                inEU: isEU(),
                fechaDate: new Date(),
                fecha: new Date().toLocaleDateString('es-ES'),
                pedidoNum: `P-${num.year}-${num.seq}`,
                albaranNum: `A-${num.year}-${num.seq}`,
                facturaNum: `F-${num.year}-${num.seq}`,
                items: cart.map(i => ({ product: i.product, qty: i.qty }))
            };

            // El pedido ya está guardado en currentOrder: se vacía la cesta y el formulario
            cart = [];
            document.getElementById('checkout-form').reset();
            sincronizarUE();
            navigate('thanks-view');
        }

        function volverATienda() {
            document.querySelectorAll('.cat-btn').forEach((b, i) => b.classList.toggle('active', i === 0));
            navigate('home-view', 'All');
        }

        // Plantilla Excel diseñada (Pedido, Albarán y Factura) en base64
        const PLANTILLA_XLSX_B64 = "";

        // ---------- Excel: rellena la plantilla diseñada (Pedido, Albarán, Factura) con ExcelJS ----------
        const MAX_LINEAS = 12;                    // la plantilla tiene 12 líneas (filas 20-31)
        const FILA_INI = 20;
        const TASAS_IVA = [0.04, 0.1, 0.21];      // filas de desglose de IVA de la plantilla
        const UE_SI = '\u2611 Cliente dentro de la UE';   // ☑
        const UE_NO = '\u2610 Cliente fuera de la UE';    // ☐
        const COND_UE = 'LEFT(Pedido!$F$16,1)="\u2611"';   // condición "dentro de la UE" (desde cualquier hoja)
        const COND_UE_LOCAL = 'LEFT($F$16,1)="\u2611"';    // idem dentro de la hoja Pedido
        const FMT_FECHA = 'dd/mm/yyyy';

        // Totales con la misma lógica que la plantilla: IVA calculado por tipo sobre la base de ese tipo
        function calcTotals(items, inEU) {
            const lines = items.map(item => {
                const base = round2(item.product.price * item.qty);
                const rate = inEU ? item.product.iva : 0;
                return { product: item.product, qty: item.qty, base, rate, total: round2(base * (1 + rate)) };
            });
            const base = round2(lines.reduce((s, l) => s + l.base, 0));
            const grupos = TASAS_IVA.map(r => round2(lines.filter(l => l.rate === r).reduce((s, l) => s + l.base, 0)));
            const ivas = grupos.map((g, i) => round2(g * TASAS_IVA[i]));
            const iva = round2(ivas.reduce((s, v) => s + v, 0));
            return { lines, base, grupos, ivas, iva, total: round2(base + iva) };
        }

        const serialExcel = d => Math.round(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) / 86400000) + 25569;
        const fechaExcel = d => new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
        const sumarDias = (d, n) => { const x = new Date(d.getTime()); x.setDate(x.getDate() + n); return x; };
        const comillas = s => '"' + String(s).replace(/"/g, '""') + '"';

        function rellenarPlantilla(wb, o, conResultados = true) {
            const c = o.client;
            const t = calcTotals(o.items, o.inEU);
            const ue = o.inEU;
            const P = wb.getWorksheet('Pedido');
            const A = wb.getWorksheet('Albarán');
            const F = wb.getWorksheet('Factura');
            const entrega = sumarDias(o.fechaDate, 3);

            // Escribe una fórmula con su resultado en caché (para visores que no recalculan)
            const fx = (ws, addr, formula, result) => {
                ws.getCell(addr).value = conResultados ? { formula, result } : { formula };
            };
            const set = (ws, addr, value, numFmt) => {
                const cell = ws.getCell(addr);
                cell.value = value;
                if (numFmt) cell.numFmt = numFmt;
            };
            const nota = ue ? '' : '  Operación sin IVA: cliente establecido fuera de la UE (exportación).';
            const direccionPais = `${c.cp} ${c.ciudad} · ${c.pais}`;

            // ================= PEDIDO =================
            set(P, 'I4', o.pedidoNum);
            set(P, 'I5', fechaExcel(o.fechaDate), FMT_FECHA);
            set(P, 'I6', fechaExcel(entrega), FMT_FECHA);
            set(P, 'F11', c.nombre);
            set(P, 'F12', 'NIF: ' + c.nif);
            set(P, 'F13', c.direccion);
            set(P, 'F14', `${c.cp} ${c.ciudad}`);
            set(P, 'F15', c.pais);
            set(P, 'F17', 'E-mail: ' + c.email);
            set(P, 'I17', 'Telf. ' + c.tel);

            // Casilla "dentro de la UE" (lista desplegable con tick): la plantilla ya trae el formato de la fila 16
            const f16 = P.getCell('F16');
            f16.font = Object.assign({}, f16.font, { bold: true, color: { argb: 'FF093375' } });
            f16.value = ue ? UE_SI : UE_NO;
            f16.dataValidation = {
                type: 'list', allowBlank: false, showErrorMessage: true,
                errorTitle: 'Dentro de la UE',
                error: 'Elige una de las dos opciones de la lista.',
                formulae: ['"' + UE_SI + ',' + UE_NO + '"']
            };

            // Líneas de pedido
            for (let i = 0; i < MAX_LINEAS; i++) {
                const r = FILA_INI + i;
                const l = t.lines[i];
                fx(P, `B${r}`, `IF(C${r}="","",ROW()-19)`, l ? i + 1 : '');
                if (l) {
                    set(P, `C${r}`, l.product.name.trim());
                    set(P, `D${r}`, l.qty);
                    set(P, `E${r}`, l.product.price);
                    set(P, `F${r}`, 0);
                    // El tipo de IVA depende de la casilla UE: fuera de la UE vale 0%
                    fx(P, `G${r}`, `IF(${COND_UE_LOCAL},${l.product.iva},0)`, l.rate);
                } else {
                    ['C', 'D', 'E', 'F', 'G'].forEach(col => set(P, `${col}${r}`, null));
                }
                fx(P, `H${r}`, `IF(OR(D${r}="",E${r}=""),"",ROUND(D${r}*E${r}*(1-N(F${r})),2))`, l ? l.base : '');
                fx(P, `I${r}`, `IF(H${r}="","",ROUND(H${r}*(1+N(G${r})),2))`, l ? l.total : '');
            }
            fx(P, 'I33', 'SUM(H20:H31)', t.base);
            [34, 35, 36].forEach((r, k) => {
                fx(P, `G${r}`, `SUMIF($G$20:$G$31,F${r},$H$20:$H$31)`, t.grupos[k]);
                fx(P, `I${r}`, `ROUND(G${r}*F${r},2)`, t.ivas[k]);
            });
            fx(P, 'F37', `IF(${COND_UE_LOCAL},"Total IVA","Total IVA (exento)")`, ue ? 'Total IVA' : 'Total IVA (exento)');
            fx(P, 'I37', 'SUM(I34:I36)', t.iva);
            fx(P, 'I38', 'I33+I37', t.total);
            fx(P, 'B37', '"Pedido "&I4', 'Pedido ' + o.pedidoNum);
            const obsP = 'Pedido sujeto a disponibilidad de stock. La entrega se realizará en la fecha solicitada salvo causa de fuerza mayor.';
            fx(P, 'B41', `${comillas(obsP)}&IF(${COND_UE_LOCAL},"","${nota}")`, obsP + nota);
            set(P, 'B53', 'Cómo usarla: el IVA se quita solo si en "Cliente" eliges ☐ fuera de la UE (lista desplegable). Documento generado automáticamente desde la web de Food4You.');

            // ================= ALBARÁN =================
            set(A, 'I4', o.albaranNum);
            set(A, 'I5', fechaExcel(entrega), FMT_FECHA);
            fx(A, 'I6', 'Pedido!I4', o.pedidoNum);
            fx(A, 'F11', 'Pedido!F11', c.nombre);
            fx(A, 'F12', 'Pedido!F12', 'NIF: ' + c.nif);
            fx(A, 'F13', 'Pedido!F13', c.direccion);
            fx(A, 'F14', 'Pedido!F14&" · "&Pedido!F15', direccionPais);
            for (let i = 0; i < MAX_LINEAS; i++) {
                const r = FILA_INI + i;
                const l = t.lines[i];
                fx(A, `B${r}`, `IF(C${r}="","",ROW()-19)`, l ? i + 1 : '');
                fx(A, `C${r}`, `IF(Pedido!C${r}="","",Pedido!C${r})`, l ? l.product.name.trim() : '');
                fx(A, `D${r}`, `IF(Pedido!D${r}="","",Pedido!D${r})`, l ? l.qty : '');
                set(A, `E${r}`, l ? l.qty : null);   // Entregado
                fx(A, `F${r}`, `IF(D${r}="","",D${r}-N(E${r}))`, l ? 0 : '');
                set(A, `G${r}`, l ? 1 : null);       // Bultos
                set(A, `H${r}`, null);               // Observaciones
            }
            const totQty = o.items.reduce((s, i) => s + i.qty, 0);
            fx(A, 'D32', 'SUM(D20:D31)', totQty);
            fx(A, 'E32', 'SUM(E20:E31)', totQty);
            fx(A, 'F32', 'SUM(F20:F31)', 0);
            fx(A, 'G32', 'SUM(G20:G31)', t.lines.length);
            set(A, 'B48', 'Cómo usarla: concepto y cantidad pedida se traen de la hoja Pedido. Documento generado automáticamente desde la web de Food4You.');

            // ================= FACTURA =================
            set(F, 'I4', o.facturaNum);
            set(F, 'I5', fechaExcel(o.fechaDate), FMT_FECHA);
            set(F, 'I6', 30);
            fx(F, 'I7', 'I5+I6', serialExcel(o.fechaDate) + 30);
            F.getCell('I7').numFmt = FMT_FECHA;
            fx(F, 'F11', 'Pedido!F11', c.nombre);
            fx(F, 'F12', 'Pedido!F12', 'NIF: ' + c.nif);
            fx(F, 'F13', 'Pedido!F13', c.direccion);
            fx(F, 'F14', 'Pedido!F14&" · "&Pedido!F15', direccionPais);
            fx(F, 'B16',
                `"Pedido "&Pedido!I4&"   ·   Albarán "&Albarán!I4&"   ·   "&IF(${COND_UE},"Cliente dentro de la UE","Cliente fuera de la UE (sin IVA)")`,
                `Pedido ${o.pedidoNum}   ·   Albarán ${o.albaranNum}   ·   ` + (ue ? 'Cliente dentro de la UE' : 'Cliente fuera de la UE (sin IVA)'));
            for (let i = 0; i < MAX_LINEAS; i++) {
                const r = FILA_INI + i;
                const l = t.lines[i];
                fx(F, `B${r}`, `IF(C${r}="","",ROW()-19)`, l ? i + 1 : '');
                fx(F, `C${r}`, `IF(Pedido!C${r}="","",Pedido!C${r})`, l ? l.product.name.trim() : '');
                fx(F, `D${r}`, `IF(C${r}="","",N(Albarán!E${r}))`, l ? l.qty : '');
                fx(F, `E${r}`, `IF(C${r}="","",Pedido!E${r})`, l ? l.product.price : '');
                fx(F, `F${r}`, `IF(C${r}="","",N(Pedido!F${r}))`, l ? 0 : '');
                fx(F, `G${r}`, `IF(C${r}="","",N(Pedido!G${r}))`, l ? l.rate : '');
                fx(F, `H${r}`, `IF(OR(D${r}="",E${r}=""),"",ROUND(D${r}*E${r}*(1-N(F${r})),2))`, l ? l.base : '');
                fx(F, `I${r}`, `IF(H${r}="","",ROUND(H${r}*(1+N(G${r})),2))`, l ? l.total : '');
            }
            fx(F, 'I33', 'SUM(H20:H31)', t.base);
            [34, 35, 36].forEach((r, k) => {
                fx(F, `G${r}`, `SUMIF($G$20:$G$31,F${r},$H$20:$H$31)`, t.grupos[k]);
                fx(F, `I${r}`, `ROUND(G${r}*F${r},2)`, t.ivas[k]);
            });
            fx(F, 'F37', `IF(${COND_UE},"Total IVA","Total IVA (exento)")`, ue ? 'Total IVA' : 'Total IVA (exento)');
            fx(F, 'I37', 'SUM(I34:I36)', t.iva);
            fx(F, 'I38', 'I33+I37', t.total);
            fx(F, 'B37', '"Factura "&I4', 'Factura ' + o.facturaNum);
            const obsF = 'Gracias por confiar en Food4You. Por favor, indique el número de factura como referencia al realizar la transferencia.';
            fx(F, 'B41', `${comillas(obsF)}&IF(${COND_UE},"","${nota}")`, obsF + nota);
            set(F, 'B48', 'Cómo usarla: cliente, conceptos, precios e IVA se traen de Pedido; las cantidades, de las unidades entregadas en Albarán. Documento generado automáticamente desde la web de Food4You.');

            // Área de impresión (ExcelJS necesita el $ de la fila para guardarla como referencia absoluta)
            P.pageSetup.printArea = 'A$1:J$51';
            A.pageSetup.printArea = 'A$1:J$47';
            F.pageSetup.printArea = 'A$1:J$46';

            wb.creator = 'Food4You (empresa simulada con fines educativos)';
            wb.calcProperties = { fullCalcOnLoad: true };
            return t;
        }

        function base64ABuffer(b64) {
            const bin = atob(b64);
            const bytes = new Uint8Array(bin.length);
            for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
            return bytes.buffer;
        }

        async function descargarExcel() {
            if (!currentOrder) return;
            try {
                const wb = new ExcelJS.Workbook();
                await wb.xlsx.load(base64ABuffer(PLANTILLA_XLSX_B64));
                rellenarPlantilla(wb, currentOrder);
                const buffer = await wb.xlsx.writeBuffer();
                const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = 'Food4You_Documentacion.xlsx';
                document.body.appendChild(a);
                a.click();
                a.remove();
                setTimeout(() => URL.revokeObjectURL(url), 2000);
            } catch (err) {
                console.error(err);
                alert('No se ha podido generar el Excel. Comprueba tu conexión (se carga la librería ExcelJS) e inténtalo de nuevo.');
            }
        }

        // ---------- Aviso tipo cookies ----------
        function aceptarAviso() {
            document.getElementById('sim-banner').classList.add('sim-hide');
            try { sessionStorage.setItem('food4you_aviso_ok', '1'); } catch (e) { /* sin almacenamiento */ }
        }

        // Logo de Food4You incrustado (no depende de ningún archivo externo)
        const LOGO_SRC = "data:image/png;base64,";

        function iniciarReveal() {
            const els = document.querySelectorAll('.reveal');
            if (!('IntersectionObserver' in window)) { els.forEach(e => e.classList.add('in')); return; }
            const io = new IntersectionObserver(entries => {
                entries.forEach(en => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
            }, { threshold: 0.12 });
            els.forEach(e => io.observe(e));
        }

        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('img[data-logo]').forEach(img => { img.src = LOGO_SRC; });
            cargarPaises();
            renderProducts();
            renderDestacados();
            iniciarReveal();
            sincronizarUE();
            let visto = false;
            try { visto = sessionStorage.getItem('food4you_aviso_ok') === '1'; } catch (e) { /* sin almacenamiento */ }
            if (visto) document.getElementById('sim-banner').classList.add('sim-hide');
        });
    </script>
